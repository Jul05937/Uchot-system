@startuml


left to right direction
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor White
    BorderColor Black
}

actor "Кассир" as Cashier
actor "Пассажир" as Passenger

rectangle {
    usecase "Вход в систему" as UC_LoginCashier
    usecase "Меню пассажиров" as UC_Menu
    usecase "Добавить кассира" as UC_AddCashier
    usecase "Регистрация пассажира" as UC_RegPassenger
    usecase "Выбор пассажира" as UC_SelectPassenger
    usecase "Оформление билета" as UC_Ticket
    usecase "Возврат билета" as UC_Refund
    usecase "Поиск рейса" as UC_Search
    usecase "Выбор места" as UC_Seat
    usecase "Просмотр доступных рейсов" as UC_ViewTripsCashier

    usecase "Вход в систему" as UC_LoginPassenger
    usecase "Просмотр доступных рейсов" as UC_ViewTripsPassenger
    usecase "Регистрация" as UC_RegPassenger2
}

' --- Кассир ---
Cashier --UC_LoginCashier
UC_LoginCashier --UC_Menu
UC_LoginCashier --UC_AddCashier
UC_LoginCashier--UC_Search
UC_LoginCashier --UC_ViewTripsCashier
UC_Menu --UC_RegPassenger
UC_Menu --UC_SelectPassenger
UC_SelectPassenger --UC_Ticket
UC_SelectPassenger --UC_Refund
UC_Ticket --UC_Search
UC_Ticket --UC_Seat
UC_Search--UC_Seat

' --- Пассажир ---
Passenger --UC_LoginPassenger
Passenger --UC_RegPassenger2
UC_LoginPassenger --UC_ViewTripsPassenger
UC_LoginPassenger--UC_Ticket
UC_LoginPassenger--UC_Refund

' --- Include ---
UC_Ticket .> UC_Seat : <<include>>
UC_Ticket .> UC_Search : <<include>>


@enduml